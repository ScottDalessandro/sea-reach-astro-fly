---
// Sea Reach - Point Pleasant Beach Rental Property
export const prerender = true;
import { Image } from 'astro:assets';

// Import local images for optimization
import houseBackyard from '../assets/images/house-backyard.jpg';
import kitchen from '../assets/images/kitchen.jpeg';
import outdoorSeatsFirePit from '../assets/images/outdoor-seats-fire-pit.jpg';
import masterBedroom1 from '../assets/images/master-bedroom-1.jpg';
import garageGameroom from '../assets/images/garage-gameroom.jpg';
import porchDesk from '../assets/images/porch-desk.jpg';
import bedroomSurf from '../assets/images/bedroom-surf.jpg';
import bedroomBunk from '../assets/images/bedroom-bunk.jpeg';
import bedroom3 from '../assets/images/bedroom-3.jpeg';
import outdoorDining from '../assets/images/outdoor-dining.jpg';
import backyardSlipNSlide from '../assets/images/backyard-slip-n-slide.webp';
import beachFun from '../assets/images/beckett-beach-sand.webp';
import boardwalkFun from '../assets/images/jenkinsons-big-chair-kids.webp';
import lastWave from '../assets/images/lastwave-scott-casey.webp';
import logo from '../assets/logos/sea-reach-logo-light.png';
import trainBoardwalk from '../assets/images/train-boardwalk.webp';
import miniGolf from '../assets/images/mini-golf-2.webp';
import familyPhoto from '../assets/images/family-photo.jpg';
import arcade from '../assets/images/arcade.webp';
import swingsBoardwalk from '../assets/images/swings-boardwalk.jpg';
import diningRoomFull from '../assets/images/dining-room-full.jpg';
import diningRoom from '../assets/images/dining-room.jpg';
import frontCouch from '../assets/images/front-couch.jpg';

import crewPiratesGarage from '../assets/images/the-crew-pirates-garage.jpg';
import swingRideBoardwalk from '../assets/images/swing-ride-boardwalk.jpg';
import miniGolfPhoto from '../assets/images/mini-golf.jpg';
import tatumGlassesCouch from '../assets/images/tatum-glasses-couch.jpg';
import outdoorShower from '../assets/images/outdoor-shower.jpg';
import bathroom from '../assets/images/bathroom.jpg';
import office2 from '../assets/images/office-2.jpg';
import masterBD2 from '../assets/images/Master-BD-2.jpg';
import livingRoomTV from '../assets/images/living-room-tv.jpg';
import livingRoomOppo from '../assets/images/Living-Room-Oppo copy.jpg';
import sunsetRide from '../assets/images/sunset-ride-vertical.jpg';
import beckettFireworks from '../assets/images/beckett-fireworks.jpg';
import PhotoLightboxIsland from '../components/PhotoLightboxIsland.astro';

// Gallery photos in tour order
const galleryPhotos = [
  { img: livingRoomTV, alt: 'Living room with couch and TV' },
  { img: kitchen, alt: 'Gourmet kitchen with granite counters' },
  { img: diningRoomFull, alt: 'Dining table set for eight' },
  { img: frontCouch, alt: 'Wraparound porch lounge area' },
  { img: porchDesk, alt: 'Wraparound porch desk and work area' },
  { img: masterBedroom1, alt: 'Master bedroom with vaulted ceiling' },
  { img: masterBD2, alt: 'Master bedroom alternate view' },
  { img: bedroomSurf, alt: 'Queen bedroom with coastal decor' },
  { img: bedroom3, alt: 'Third bedroom with full bed' },
  { img: bedroomBunk, alt: 'Bunk room with twin bunks' },
  { img: outdoorDining, alt: 'Outdoor dining area' },
  { img: houseBackyard, alt: 'Backyard at Sea Reach' },
  { img: garageGameroom, alt: 'Garage game room with ping pong' },
  { img: bathroom, alt: 'Full bathroom' },
  { img: outdoorShower, alt: 'Private outdoor shower' },
  { img: office2, alt: 'Dedicated office workspace' },
  { img: diningRoom, alt: 'Dining room with hardwood floors and modern light fixture' },
  { img: outdoorSeatsFirePit, alt: 'Fire pit and outdoor seating', wide: true },
];

// Derive lightbox-compatible image data (using Astro-resolved src strings)
const lightboxImages = galleryPhotos.map(p => ({
  src: typeof p.img === 'string' ? p.img : p.img.src,
  width: p.img.width || 1600,
  height: p.img.height || 1200,
  alt: p.alt,
}));

const seoData = {
  title: "Sea Reach Beach House | Point Pleasant Beach, NJ — Book Direct",
  description: "4-bedroom beach house 1.5 blocks from Point Pleasant Beach. Beach badges, chairs & umbrellas included. Book direct and save vs. platforms.",
  canonical: "https://sea-reach.com",
  ogImage: "https://sea-reach.com/images/outdoor-seats-fire-pit.png"
};
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{seoData.title}</title>
    <meta name="description" content={seoData.description} />
    <link rel="canonical" href={seoData.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={seoData.canonical} />
    <meta property="og:title" content={seoData.title} />
    <meta property="og:description" content={seoData.description} />
    <meta property="og:image" content={seoData.ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={seoData.canonical} />
    <meta property="twitter:title" content={seoData.title} />
    <meta property="twitter:description" content={seoData.description} />
    <meta property="twitter:image" content={seoData.ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "LodgingBusiness",
        "name": "Sea Reach Beach House",
        "description": "4BR beach house rental in Point Pleasant Beach, NJ. Beach badges, chairs & umbrellas included every week.",
        "address": {
            "@type": "PostalAddress",
            "streetAddress": "106 Atlantic Ave",
            "addressLocality": "Point Pleasant Beach",
            "addressRegion": "NJ",
            "addressCountry": "US"
        },
        "geo": {
            "@type": "GeoCoordinates",
            "latitude": "40.0909",
            "longitude": "-74.0487"
        },
        "url": "https://sea-reach.com",
        "amenityFeature": [
            "Beach Access",
            "Beach Badges Included",
            "Beach Chairs Included",
            "WiFi",
            "6-Car Parking",
            "Kitchen",
            "Air Conditioning",
            "Fire Pit",
            "Game Room",
            "Outdoor Shower"
        ]
    }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Serif+Display&display=swap" rel="stylesheet" />

    <!-- Icons -->
    <script src="https://code.iconify.design/iconify-icon/2.1.0/iconify-icon.min.js"></script>
</head>
<body>

<!-- NAVIGATION -->
<nav class="nav transparent" id="mainNav">
    <div class="nav-inner">
        <a href="#" class="nav-logo">
            <Image
                src={logo}
                alt="Sea Reach Beach House"
                height={64}
                class="nav-logo-img"
                loading="eager"
            />
        </a>
        <div class="nav-links" id="navLinks">
            <a href="#week">The House</a>
            <a href="#story">Our Story</a>
            <a href="#zones">Nine Zones</a>
            <a href="#gallery">Photos</a>
            <a href="#included">What's Included</a>
            <a href="#neighborhood">The Neighborhood</a>
            <a href="#faq">FAQ</a>
            <a href="#contact" class="btn-primary" style="padding: 10px 24px; font-size: 0.9rem;">Book Now</a>
        </div>
        <button class="hamburger" id="hamburgerBtn" aria-label="Open menu">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>

<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobileMenu">
    <button class="mobile-close" id="mobileClose" aria-label="Close menu">
        <iconify-icon icon="solar:close-circle-linear" style="font-size: 32px; color: #1b2e50;" width="32" height="32"></iconify-icon>
    </button>
    <a href="#week" onclick="closeMobile()">The House</a>
    <a href="#story" onclick="closeMobile()">Our Story</a>
    <a href="#zones" onclick="closeMobile()">Nine Zones</a>
    <a href="#gallery" onclick="closeMobile()">Photos</a>
    <a href="#included" onclick="closeMobile()">What's Included</a>
    <a href="#neighborhood" onclick="closeMobile()">The Neighborhood</a>
    <a href="#faq" onclick="closeMobile()">FAQ</a>
    <a href="#contact" class="btn-primary" onclick="closeMobile()" style="margin-top: 8px;">Book Now</a>
</div>

<!-- HERO -->
<section class="hero">
    <div class="hero-bg">
        <Image src={swingRideBoardwalk} alt="Swing ride on the boardwalk"
            class="hero-bg-img hero-slide active" loading="eager" format="webp" quality={85} />
        <Image src={beachFun} alt="Beckett playing in the sand at the beach"
            class="hero-bg-img hero-slide" loading="lazy" format="webp" quality={85} />
        <Image src={beckettFireworks} alt="Beckett watching fireworks at the shore"
            class="hero-bg-img hero-slide" loading="lazy" format="webp" quality={85} />
        <Image src={crewPiratesGarage} alt="The crew in pirate costumes in the garage"
            class="hero-bg-img hero-slide" loading="lazy" format="webp" quality={85} />
        <Image src={miniGolfPhoto} alt="Mini golf at the shore"
            class="hero-bg-img hero-slide" loading="lazy" format="webp" quality={85} />
        <Image src={tatumGlassesCouch} alt="Relaxing on the couch at Sea Reach"
            class="hero-bg-img hero-slide" loading="lazy" format="webp" quality={85} />
    </div>
    <div class="hero-overlay"></div>
    <div class="container" style="position: relative; z-index: 2;">
        <div class="hero-content">
            <div class="hero-eyebrow">POINT PLEASANT BEACH, NJ</div>
            <h1>Where Sandy Feet and Slow Mornings Are the Only Plans You'll Need</h1>
            <p class="hero-sub">A 4-bedroom beach house 1.5 blocks from Point Pleasant Beach — with everything you need for the week already waiting for you.</p>
            <div class="hero-buttons">
                <a href="#contact" class="btn-primary btn-primary-lg">Book Your Week</a>
                <a href="#week" class="btn-secondary btn-secondary-white" style="padding: 14px 34px;">See What a Week Looks Like</a>
            </div>
        </div>
    </div>
    <div class="hero-stats">
        <div class="hero-stats-inner">
            <div>
                <div class="stat-value">4 min</div>
                <div class="stat-label">Walk to Beach</div>
            </div>
            <div>
                <div class="stat-value">4</div>
                <div class="stat-label">Bedrooms</div>
            </div>
